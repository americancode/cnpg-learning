apiVersion: v1
kind: Secret
metadata:
  name: crunchy-source-migrator
  namespace: migration-db
type: Opaque
stringData:
  password: "__CRUNCHY_SOURCE_MIGRATOR_PASSWORD__"
---
apiVersion: v1
kind: Secret
metadata:
  name: cnpg-target-superuser
  namespace: migration-db
type: kubernetes.io/basic-auth
stringData:
  username: postgres
  password: "__CRUNCHY_SOURCE_MIGRATOR_PASSWORD__"
---
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: cnpg-target-store
  namespace: migration-db
spec:
  retentionPolicy: 7d
  configuration:
    destinationPath: s3://crunchy-cnpg-migration/
    endpointURL: http://minio.migration-db.svc.cluster.local:9000
    s3Credentials:
      accessKeyId:
        name: minio-creds
        key: ACCESS_KEY_ID
      secretAccessKey:
        name: minio-creds
        key: ACCESS_SECRET_KEY
    data:
      compression: gzip
    wal:
      compression: gzip
      maxParallel: 8
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cnpg-target
  namespace: migration-db
spec:
  instances: 1
  imageName: ghcr.io/cloudnative-pg/postgresql:17.5
  imagePullPolicy: IfNotPresent
  enableSuperuserAccess: true
  superuserSecret:
    name: cnpg-target-superuser
  bootstrap:
    pg_basebackup:
      source: crunchy-source
  storage:
    size: 5Gi
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: true
      parameters:
        barmanObjectName: cnpg-target-store
        serverName: cnpg-target
  externalClusters:
    - name: crunchy-source
      connectionParameters:
        host: crunchy-source-primary.migration-db.svc
        user: migrator
        dbname: app
        sslmode: require
      password:
        name: crunchy-source-migrator
        key: password
